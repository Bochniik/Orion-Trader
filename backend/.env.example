OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_MAX_OUTPUT_TOKENS=1200
MARKET_CONTEXT_TTL_SECONDS=60
# Required only for Move Lab SEC filing metadata. Use an application name and
# monitored contact, for example: OrionTrader research contact@example.com
SEC_USER_AGENT=
ORION_AUTH_DISABLED=false
ORION_ALLOW_REGISTRATION=true
ORION_COOKIE_SECURE=false
ORION_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALPACA_ORDER_SUBMISSION_ENABLED=false
# Move Lab WebSockets are explicit, research-only sessions. Market data stays
# in memory; normalized public news is written to the user's audit database.
ORION_STREAM_MAX_SESSION_MINUTES=240
ORION_ALPACA_STREAM_TRADES=false
ORION_ALPACA_ALL_NEWS_ENABLED=false
ORION_AUTONOMY_ENABLED=false
TRADING212_DEMO_ORDER_SUBMISSION_ENABLED=false
TRADING212_DEMO_MAX_ORDER_VALUE=1000
TRADING212_DEMO_MAX_POSITION_PERCENT=20
TRADING212_DEMO_MAX_DAILY_ORDERS=5
TRADING212_DEMO_MAX_DAILY_NOTIONAL=2500
TRADING212_DEMO_REVIEW_TTL_SECONDS=300
LOG_LEVEL=INFO
# Continuous staged research scanner; network work starts after Alpaca connects.
# Connect credentials per user in Data & account. They are memory-only and
# disappear on backend restart; there are no automatic Alpaca credential env imports.
# Login/session restoration resumes an already-connected scanner automatically.
# Yahoo minute features remain delayed. No alerts or orders are generated.
ORION_SCANNER_ENABLED=true
ORION_SCANNER_BROAD_INTERVAL_SECONDS=600
ORION_SCANNER_ACTIVE_INTERVAL_SECONDS=120
ORION_SCANNER_PAGE_SIZE=250
ORION_SCANNER_ACTIVITY_LIMIT=100
ORION_SCANNER_FAST_LIMIT=30
ORION_SCANNER_FULL_ANALYSIS_LIMIT=15
ORION_SCANNER_RESULT_LIMIT=10
ORION_SCANNER_ACTIVE_LIMIT=50
ORION_SCANNER_ACTIVE_TTL_SECONDS=1800
ORION_SCANNER_INACTIVE_CYCLES=3
ORION_SCANNER_IDEAL_FEATURE_AGE_SECONDS=120
ORION_SCANNER_MAXIMUM_FEATURE_AGE_SECONDS=1200
ORION_SCANNER_SNAPSHOT_TTL_SECONDS=300
ORION_SCANNER_DELAYED_PENALTY_POINTS=10
ORION_SCANNER_MINIMUM_CYCLE_GAP_SECONDS=60
ORION_SCANNER_UNIVERSE_CACHE_SECONDS=3600
ORION_SCANNER_DAILY_CACHE_SECONDS=3600
ORION_SCANNER_MINUTE_CACHE_SECONDS=60
ORION_SCANNER_CACHE_SYMBOLS=2000
ORION_SCANNER_PROVIDER_CHUNK_SIZE=10
ORION_SCANNER_PROVIDER_SPACING_SECONDS=1
